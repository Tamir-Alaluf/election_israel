generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String   @unique @map("clerk_user_id")
  email       String?
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Party {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String             @unique
  mandates       Int?
  vision         String?
  imageUrl       String?
  candidateName  String?            @map("candidate_name")
  candidates     Candidate[]        @relation("PartyCandidates")
  leader         Candidate?         @relation("PartyLeader", fields: [candidateName], references: [name])
  baseTopics     PartyBaseTopic[]
  futurePromises FuturePromise[]
  legislations   PartyLegislation[]
  members        PartyMember[]
  recentActions  RecentAction[]

  @@index([candidateName])
  @@map("parties")
}

model Candidate {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                  @unique
  image             String?                 @map("image_url")
  vision            String?
  positiveSentiment String?                 @map("positive_sentiment")
  negativeSentiment String?                 @map("negative_sentiment")
  partyName         String                  @map("party_name")
  careerActions    CandidateCareerAction[]
  education        CandidateEducation[]
  professionals    CandidateProfessional[]
  recentActions    CandidateRecentAction[]
  party            Party                   @relation("PartyCandidates", fields: [partyName], references: [name])
  partyLeaderOf    Party[]                 @relation("PartyLeader")
  publicOpinions   PublicOpinion[]

  @@index([partyName])
  @@map("candidates")
}

model PartyMember {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  orderIndex  Int     @map("order_index")
  image       String? @map("image_url")
  partyName   String  @map("party_name")
  party       Party   @relation(fields: [partyName], references: [name])

  @@index([partyName, orderIndex])
  @@map("party_members")
}

model BaseTopic {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String            @unique
  options     BaseTopicOption[]
  partyTopics PartyBaseTopic[]

  @@map("base_topics")
}

model BaseTopicOption {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionDisplayValue String           @map("option_display_value")
  baseTopicTitle     String           @map("base_topic_title")
  baseTopic          BaseTopic        @relation(fields: [baseTopicTitle], references: [title])
  partyTopics        PartyBaseTopic[]

  @@unique([baseTopicTitle, optionDisplayValue])
  @@index([baseTopicTitle])
  @@map("base_topic_options")
}

model PartyBaseTopic {
  id                          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description                 String?
  baseTopicOptionDisplayValue String          @map("base_topic_option_display_value")
  baseTopicTitle              String          @map("base_topic_title")
  partyName                   String          @map("party_name")
  option                      BaseTopicOption @relation(fields: [baseTopicTitle, baseTopicOptionDisplayValue], references: [baseTopicTitle, optionDisplayValue])
  topic                       BaseTopic       @relation(fields: [baseTopicTitle], references: [title])
  party                       Party           @relation(fields: [partyName], references: [name])

  @@index([partyName])
  @@index([baseTopicTitle])
  @@index([baseTopicOptionDisplayValue])
  @@map("party_base_topics")
}

model LegislationGroup {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @unique
  legislations Legislation[]

  @@map("legislation_groups")
}

model Legislation {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String             @unique
  legislationGroupName String             @map("legislation_group_name")
  group                LegislationGroup   @relation(fields: [legislationGroupName], references: [name])
  partyLegislations    PartyLegislation[]

  @@index([legislationGroupName])
  @@map("legislations")
}

model LegislationOption {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayValue      String             @unique @map("display_value")
  partyLegislations PartyLegislation[]

  @@map("legislation_options")
}

model PartyLegislation {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legislationTitle   String            @map("legislation_title")
  optionDisplayValue String            @map("option_display_value")
  partyName          String            @map("party_name")
  legislation        Legislation       @relation(fields: [legislationTitle], references: [title])
  option             LegislationOption @relation(fields: [optionDisplayValue], references: [displayValue])
  party              Party             @relation(fields: [partyName], references: [name])

  @@index([partyName])
  @@index([legislationTitle])
  @@index([optionDisplayValue])
  @@map("party_legislations")
}

model ActionGroup {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                  @unique
  candidateCareerActions CandidateCareerAction[]
  candidateRecentActions CandidateRecentAction[]
  futurePromises         FuturePromise[]
  recentActions          RecentAction[]

  @@map("action_groups")
}

model RecentAction {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyName       String      @map("party_name")
  title           String
  actionGroupName String      @map("action_group_name")
  description     String?
  orderIndex      Int?        @map("order_index")
  actionGroup     ActionGroup @relation(fields: [actionGroupName], references: [name])
  party           Party       @relation(fields: [partyName], references: [name])

  @@index([partyName, orderIndex])
  @@index([actionGroupName])
  @@map("party_recent_actions")
}

model FuturePromise {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyName       String      @map("party_name")
  title           String
  actionGroupName String      @map("action_group_name")
  description     String?
  orderIndex      Int?        @map("order_index")
  actionGroup     ActionGroup @relation(fields: [actionGroupName], references: [name])
  party           Party       @relation(fields: [partyName], references: [name])

  @@index([partyName, orderIndex])
  @@index([actionGroupName])
  @@map("party_future_promises")
}

model CandidateEducation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  major         String?
  startYear     Int?      @map("start_year")
  endYear       Int?      @map("end_year")
  degreeLevel   String?   @map("degree_level")
  university    String?
  description   String?
  candidateName String    @map("candidate_name")
  candidate     Candidate @relation(fields: [candidateName], references: [name])

  @@index([candidateName])
  @@map("candidate_educations")
}

model ProfessionalGroup {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                  @unique
  professionals CandidateProfessional[]

  @@map("professional_groups")
}

model CandidateProfessional {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  startYear     Int?              @map("start_year")
  endYear       Int?              @map("end_year")
  description   String?
  candidateName String            @map("candidate_name")
  groupName     String            @map("group_name")
  candidate     Candidate         @relation(fields: [candidateName], references: [name])
  group         ProfessionalGroup @relation(fields: [groupName], references: [name])

  @@index([candidateName])
  @@index([groupName])
  @@map("candidate_professionals")
}

model CandidateCareerAction {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  description     String?
  orderIndex      Int?        @map("order_index")
  actionGroupName String      @map("action_group_name")
  candidateName   String      @map("candidate_name")
  actionGroup     ActionGroup @relation(fields: [actionGroupName], references: [name])
  candidate       Candidate   @relation(fields: [candidateName], references: [name])

  @@index([candidateName, orderIndex])
  @@index([actionGroupName])
  @@map("candidate_career_actions")
}

model CandidateRecentAction {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  description     String?
  orderIndex      Int?        @map("order_index")
  actionGroupName String      @map("action_group_name")
  candidateName   String      @map("candidate_name")
  actionGroup     ActionGroup @relation(fields: [actionGroupName], references: [name])
  candidate       Candidate   @relation(fields: [candidateName], references: [name])

  @@index([candidateName, orderIndex])
  @@index([actionGroupName])
  @@map("candidate_recent_actions")
}

model PublicOpinion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sentiment     String
  description   String?
  orderIndex    Int?      @map("order_index")
  candidateName String    @map("candidate_name")
  candidate     Candidate @relation(fields: [candidateName], references: [name])

  @@index([candidateName, orderIndex])
  @@map("public_opinions")
}

model GlossaryCategory {
  id    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String         @unique
  terms GlossaryTerm[]

  @@map("glossary_categories")
}

model GlossaryTerm {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String
  definition           String
  glossaryCategoryName String           @map("glossary_category_name")
  category             GlossaryCategory @relation(fields: [glossaryCategoryName], references: [name])

  @@index([glossaryCategoryName])
  @@map("glossary_terms")
}
